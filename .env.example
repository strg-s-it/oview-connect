; =============================================================================
; connect/.env.example
;
; Vorlage fuer die Connect-Konfiguration. Kopieren nach ".env" und Werte
; eintragen. Die echte ".env" darf NICHT ins FTP-Sync/Git aufgenommen werden,
; da sie Zugangsdaten und den Verschluesselungs-Key enthaelt.
;
; Wichtig: PHPs parse_ini_file() unterstuetzt NUR ";" als Kommentarzeichen,
; nicht "#" -- eine Zeile mit "#" und einem Anfuehrungszeichen fuehrt zu
; einem Parse-Fehler. Deshalb ausschliesslich ";" fuer Kommentare verwenden,
; auch in der spaeter ausgefuellten echten .env.
;
; Warum eine eigene .env statt der bestehenden Root-.env?
; Connect soll sich unabhaengig auf neuer Infrastruktur installieren lassen
; (siehe Plan, Abschnitt "Portabilitaet"). Deshalb kennt Connect ausschliesslich
; diese Datei und weiss nichts von config.php/.env im Repo-Root.
; =============================================================================

; --- Eigene Datenbank (neues Schema "oview_connect" auf der bestehenden ---
; --- MariaDB 5.x -- siehe Plan, Abschnitt "MariaDB 5.x auf dem aktuellen  ---
; --- Server": kein JSON-Typ, keine CTEs/Window-Functions im Schema)      ---
CONNECT_DB_HOST=localhost
CONNECT_DB_PORT=3306
CONNECT_DB_NAME=oview_connect
CONNECT_DB_USER=
CONNECT_DB_PASS=

; --- Verschluesselung fuer gespeicherte Connection-Zugangsdaten ---
; 32 zufaellige Bytes als Hex, z. B. erzeugt mit:
;   php -r "echo bin2hex(random_bytes(32));"
CONNECT_ENCRYPTION_KEY=

; --- Basis-URL dieser Connect-Installation ---
; Connect laeuft auf einer EIGENEN Subdomain (nicht als Unterordner von
; oview.at) -- u.a. damit in Plesk eine eigene, neuere PHP-Version zugewiesen
; werden kann, ohne die Haupt-Domain (PHP 7.3) anzuruehren. Wird fuer OAuth-
; Redirect-URLs (Shopify) und kuenftige Webhook-Endpunkte verwendet --
; bewusst konfigurierbar statt im Code hartkodiert (vgl. das bestehende
; Muster mit fest eingetragenem "https://oview.at/..." in webhooks/order_paid.php).
; Diese URL muss im Shopify Partner Dashboard als zusaetzliche "Allowed
; redirection URL" fuer die App eingetragen werden (Pfad: /auth/callback).
CONNECT_APP_URL=https://connect.oview.at

; --- Shopify App-Zugangsdaten ---
; Dieselbe Shopify-Partner-App wie die alte Welt (SHOPIFY_API_KEY aus der
; Root-.env), unabhaengig in Connect hinterlegt -- keine Datei-Abhaengigkeit,
; aber bewusst derselbe App-Eintrag, damit Kunden die App nicht neu
; installieren muessen. CONNECT_SHOPIFY_API_SECRET: der App-Secret-Wert aus
; inc/webhook_helper.php (SHOPIFY_APP_SECRET-Konstante) der alten Welt.
CONNECT_SHOPIFY_API_KEY=
CONNECT_SHOPIFY_API_SECRET=
; Bewusst NICHT dieselbe Version wie die alte Welt (2024-10) -- die neue
; Welt ist unabhaengig und darf die aktuelle stabile Version nutzen
; (Stand 09/2026: 2026-07; 2026-10 ist zu diesem Zeitpunkt nur Release
; Candidate). Regelmaessig pruefen: https://shopify.dev/docs/api/usage/versioning
CONNECT_SHOPIFY_API_VERSION=2026-07
CONNECT_SHOPIFY_SCOPES=read_all_orders,read_orders,write_orders,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_products,write_products,read_inventory,write_inventory,read_locations

; --- Optionale Migrationsbruecke zur bestehenden oView-Installation ---
; Nur ausfuellen, wenn Connect NEBEN der bestehenden oView-Installation
; laeuft und der "Neue Welt (Beta)"-Button + die einmalige Shopify-Token-
; Uebernahme genutzt werden sollen. Auf einer komplett neuen Installation
; ohne Alt-System leer lassen -- Connect kommt dann ohne diese Werte aus.
LEGACY_DB_HOST=
LEGACY_DB_PORT=3306
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASS=

; --- Schutz der ausgehenden Aufrufe (siehe Connect\Http\OutboundGuard) ---
; Standard: aktiv. Erlaubt nur https und nur Ziele mit oeffentlicher IPv4-Adresse (kein localhost,
; keine privaten Netze, keine Cloud-Metadaten). NOTSCHALTER: sperrt der Waechter einmal eine
; legitime Anbindung faelschlich, hier auf "off" stellen -- wirkt sofort, ohne Neustart.
; CONNECT_OUTBOUND_GUARD=off

; --- Rechnungs-Mailversand (siehe Connect\Mail\InvoiceMailer) ---
; Absenderadresse fuer den SYSTEM-Mailversand (kein eigenes SMTP des Merchants
; hinterlegt/fehlgeschlagen) -- ueber die lokale Mailfunktion des Servers (PHP
; mail()), nicht ueber ein eigenes SMTP-Konto. Leer lassen, um automatisch aus
; CONNECT_APP_URL abzuleiten (z.B. "no-reply@connect.oview.at").
CONNECT_SYSTEM_MAIL_FROM=

; Empfaenger fuer Rechnungs-Fehler, wenn ein Shop selbst keine eigene Adresse
; hinterlegt hat (connect_shops.invoice_error_notification_email).
CONNECT_ERROR_NOTIFICATION_EMAIL=office@oview.at

; --- Logging (siehe Connect\Logging\Logger) ---
CONNECT_LOG_DIR=logs
CONNECT_LOG_LEVEL=info
